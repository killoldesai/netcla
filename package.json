{
  "name": "netofficials",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "site-plan:build": "tsx scripts/build-site-plan.ts",
    "shots": "tsx --env-file=.env scripts/shot-draft.tsx",
    "specs:sync": "tsx --env-file-if-exists=.env scripts/sync-page-specs.ts",
    "page-specs:import": "tsx --env-file-if-exists=.env scripts/import-page-specs.ts",
    "pipeline:pilot": "tsx --env-file-if-exists=.env scripts/generate-pilot.ts",
    "icons:build": "tsx scripts/build-icon-sprite.ts",
    "site-plan:import": "tsx --env-file-if-exists=.env scripts/import-site-plan.ts",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "next dev --port 3010",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "icons:brands": "tsx --env-file-if-exists=.env scripts/build-brand-icons.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "owner:create": "tsx --env-file-if-exists=.env scripts/create-owner.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "design:presentations": "tsx scripts/build-presentations.ts",
    "typecheck": "tsc --noEmit",
    "design:import": "tsx scripts/import-designs.ts",
    "design:homepage": "tsx scripts/build-stripe-homepage.ts",
    "test:homepage": "node tests/connected-homepage-browser.cjs",
    "test:homepage-leads": "node tests/connected-homepage-leads.cjs",
    "test:visual": "node scripts/check-designs.cjs",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
    "design:seed": "tsx scripts/build-seed.ts",
    "test:api": "node tests/api-integration.cjs",
    "db:test-server": "tsx scripts/local-test-db.ts",
    "owner:rotate": "tsx --env-file-if-exists=.env scripts/rotate-owner-password.ts",
    "test:interactions": "node tests/browser-interactions.cjs",
    "test:admin": "node tests/admin-workflows.cjs",
    "test:admin-login": "node tests/admin-login.cjs",
    "test:rich-editor": "node tests/rich-editor-browser.cjs",
    "test:manual-review": "node tests/admin-manual-review.cjs",
    "test:forms": "node tests/lead-browser.cjs",
    "test:layout": "node tests/layout-stress.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1146.0",
    "@aws-sdk/client-bedrock-runtime": "^3.800.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sesv2": "^3.1147.0",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cheerio": "^1.1.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "htmlparser2": "^12.0.0",
    "next": "^16.3.8",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "^3.4.0",
    "devicon": "^2.17.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "simple-icons": "^16.32.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "type": "module"
}
