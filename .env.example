DATABASE_URL=
DIRECT_DATABASE_URL=
SITE_URL=http://localhost:3000
STAGING=true
SESSION_SECRET=
RATE_LIMIT_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD=
AI_PROVIDER=openrouter
AI_MODEL=
AI_MAX_TOKENS=12000
AI_MAX_BATCH=10
AI_TIMEOUT_MS=180000
GA4_ID=
DESIGN_PREVIEW_MODE=false
TRUST_PROXY=false

# Server-only 64-character hex key; same value on web and worker. Provider keys are saved in Admin Settings.
PROVIDER_ENCRYPTION_KEY=

# Shared persistent volume on BOTH Coolify web and worker containers.
PERSISTENT_ASSET_DIR=/data/assets
PRIVATE_CV_DIR=/data/cvs
# Private ClamAV sidecar; unavailable scanner rejects CV submissions.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
